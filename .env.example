# Copy to .env next to this file. scripts\run_server.bat loads it.

# Access token the phone app asks for. Make it long and random.
GT_TOKEN=change-me-to-a-long-random-string

# mt5 = trade through the logged-in MT5 terminal on this machine, sim = simulator (no money)
GT_BROKER=mt5
MT5_SYMBOL=XAUUSD
# Leave MT5_LOGIN/PASSWORD/SERVER empty to use the account the terminal is already logged in to.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# MT5_PATH=C:\Program Files\Capital.com MT5 Terminal\terminal64.exe

# Hard cap on lot size; the Settings screen can lower it further but not raise it above the broker max.
GT_MAX_LOT=0.04

GT_HOST=0.0.0.0
GT_PORT=8080
GT_DB=gold-trader.db

# --- Telegram signals (optional) ---
# Parsing uses Claude; get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Only for an organisation-level key: the workspace id (wrkspc_...) from console.anthropic.com -> Settings -> Workspaces
ANTHROPIC_WORKSPACE_ID=
# From https://my.telegram.org -> API development tools. Then run once:  py -m scripts.telegram_login
TG_API_ID=
TG_API_HASH=
TG_SESSION=telegram.session

# --- Markets (Market Watch, built in) ---
# Signals and trade ideas for gold, silver, oil, forex and crypto on the Markets tab.
# Works without keys (demo data, clearly labelled); gold uses the MT5 terminal's own candles.
MW_ENABLED=false
MW_REFRESH_SECONDS=120
# Live metals / FX / oil (free key at twelvedata.com); Yahoo is used when it's missing or rate-limited
TWELVEDATA_API_KEY=
# News + sentiment (free key at marketaux.com)
MARKETAUX_API_KEY=
# Optional: a Telegram BOT that messages you when a signal flips (not your listener account)
MW_ALERT_BOT_TOKEN=
MW_ALERT_CHAT_ID=

# The gold idea goes to Signals as the "Market Watch" channel (trust weight, mode, P1-P3 like any channel)
MW_FEED_ENABLED=false
MW_FEED_TIMEFRAME=4h
MW_FEED_MIN_CONFIDENCE=40
MW_FEED_MIN_SCORE=20
# TP1-TP3 as multiples of the stop distance -> P1-P3; empty = the idea's own target and the preset steps
MW_FEED_TP_RS=1,2,3
# Also close when the idea goes inactive (default: only when it flips side)
MW_FEED_CLOSE_ON_INACTIVE=false

# News blackout: no new feed entries around high-impact releases (Forex Factory calendar)
NEWS_FILTER_ENABLED=true
NEWS_BLOCK_BEFORE_MIN=60
NEWS_BLOCK_AFTER_MIN=180
NEWS_BLOCK_IMPACTS=high

# --- Auto-trade for the OTHER Markets assets (silver, oil, forex, crypto) ---
# Gold is never auto-traded here: the gold idea is a Signals channel managed by the gold engine.
# Same settings as the old Market Watch app. dry_run logs intents only; mt5 places orders through
# this terminal (GT_BROKER=mt5). Real accounts are refused unless AUTO_TRADE_ALLOW_LIVE=true.
AUTO_TRADE_ENABLED=false
AUTO_TRADE_MODE=dry_run
AUTO_TRADE_TIMEFRAME=4h
AUTO_TRADE_ALLOW_LIVE=false
AUTO_TRADE_MAX_POSITIONS=3
AUTO_TRADE_RISK_PERCENT=0.5
# Risk % by signal strength level 1/2/3
AUTO_TRADE_RISK_L1=2
AUTO_TRADE_RISK_L2=3.5
AUTO_TRADE_RISK_L3=5
AUTO_TRADE_MIN_CONFIDENCE=40
AUTO_TRADE_MIN_SCORE=20
AUTO_TRADE_MAGIC=260731
# Break-even / trailing in R multiples, partial TPs, filters: see market/autotrader.py for every option
AUTO_TRADE_BREAK_EVEN_R=0.5
AUTO_TRADE_TRAIL_START_R=1.0
AUTO_TRADE_TRAIL_DIST_R=0.7
AUTO_TRADE_PARTIAL_TPS=false
AUTO_TRADE_CONFIRM_TREND=true
AUTO_TRADE_BLOCK_HOURS=21,22
# Broker symbol names (adjust suffixes, e.g. XAGUSD.m)
MT5_SYMBOL_SILVER=XAGUSD
MT5_SYMBOL_OIL=USOIL
MT5_SYMBOL_EURUSD=EURUSD
MT5_SYMBOL_GBPUSD=GBPUSD
MT5_SYMBOL_USDJPY=USDJPY
MT5_SYMBOL_BTC=BTCUSD
MT5_SYMBOL_ETH=ETHUSD

# --- Sweep+BOS strategy (liquidity sweep + break of structure) ---
# Gold setups go to Signals as the "Sweep+BOS" channel; other assets listed here are ordered via MT5.
SWEEP_BOS_ENABLED=false
SWEEP_BOS_ASSETS=gold
SWEEP_BOS_MIN_RR=2
SWEEP_BOS_MAGIC=260732
SWEEP_BOS_RISK_PERCENT=0.5
