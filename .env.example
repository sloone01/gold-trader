# Copy to .env next to this file. scripts\run_server.bat loads it.

# Access token the phone app asks for. Make it long and random.
GT_TOKEN=change-me-to-a-long-random-string

# mt5 = trade through the logged-in MT5 terminal on this machine, sim = simulator (no money)
GT_BROKER=mt5
MT5_SYMBOL=XAUUSD
# Leave MT5_LOGIN/PASSWORD/SERVER empty to use the account the terminal is already logged in to.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# MT5_PATH=C:\Program Files\Capital.com MT5 Terminal\terminal64.exe

# Hard cap on lot size; the Settings screen can lower it further but not raise it above the broker max.
GT_MAX_LOT=0.04

GT_HOST=0.0.0.0
GT_PORT=8080
GT_DB=gold-trader.db

# --- Telegram signals (optional) ---
# Parsing uses Claude; get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Only for an organisation-level key: the workspace id (wrkspc_...) from console.anthropic.com -> Settings -> Workspaces
ANTHROPIC_WORKSPACE_ID=
# From https://my.telegram.org -> API development tools. Then run once:  py -m scripts.telegram_login
TG_API_ID=
TG_API_HASH=
TG_SESSION=telegram.session
